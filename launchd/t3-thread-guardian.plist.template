<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Replace __HOME__ with your home folder and pick your own label, then save as
     ~/Library/LaunchAgents/<label>.plist and load it with launchctl bootstrap gui/$(id -u) <file>. -->
<plist version="1.0"><dict>
<key>Label</key><string>local.thread-health-watch.guardian</string>
<key>ProgramArguments</key><array><string>/opt/homebrew/bin/python3</string><string>-B</string><string>__HOME__/Library/Caches/thread-watch-v2/watch_v2.py</string><string>--config</string><string>__HOME__/Library/Caches/thread-watch-v2/live/config.json</string></array>
<key>WorkingDirectory</key><string>__HOME__/Library/Caches/thread-watch-v2</string>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer><key>Umask</key><integer>63</integer>
<key>StandardOutPath</key><string>/dev/null</string><key>StandardErrorPath</key><string>__HOME__/Library/Caches/thread-watch-v2/live/launch-error.log</string>
</dict></plist>
